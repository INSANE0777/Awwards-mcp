{
  "name": "awwwards-mcp",
  "version": "1.18.0",
  "mcpName": "io.github.insane0777/awwwards-mcp",
  "description": "Awwwards design inspiration, screenshots, motion and scene evidence for AI agents.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "awwwards-mcp": "dist/cli.js",
    "awwwards-index": "dist/index-cli.js",
    "awwwards-verify": "dist/verify-cli.js",
    "awwwards-build-project": "dist/build-project-cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "awwwards",
    "design",
    "inspiration",
    "web-design",
    "screenshots",
    "agent-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INSANE0777/Awwwards-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/INSANE0777/Awwwards-mcp/issues"
  },
  "homepage": "https://github.com/INSANE0777/Awwwards-mcp#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "index": "node dist/index-cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "smoke": "tsx test/live-smoke.ts",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "protocol:smoke": "node scripts/protocol-smoke.mjs",
    "registry:gate": "node scripts/registry-gate.mjs",
    "drift": "node scripts/parser-drift-probe.mjs",
    "doctor": "node scripts/doctor.mjs",
    "perf:bench": "node scripts/perf-bench.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/mocker": "^4.1.12",
    "ffmpeg-static": "^5.3.0",
    "gsap": "3.12.5",
    "playwright": "^1.63.0",
    "three": "0.160.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "optionalDependencies": {
    "spectorjs": "0.9.33"
  }
}
